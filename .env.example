# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- Supabase (client + server) -------------------------------------------
# Project URL and keys from Supabase Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- API-Football (result syncing in app/api/sync-results) ----------------
# Key from https://www.api-football.com/ (api-sports.io).
API_FOOTBALL_KEY=your-api-football-key
API_FOOTBALL_WORLD_CUP_LEAGUE_ID=1
API_FOOTBALL_SEASON=2026

# --- Cron auth ------------------------------------------------------------
# Used to authenticate the Vercel cron routes. On Vercel, set this in the
# project env vars; Vercel then sends `Authorization: Bearer $CRON_SECRET`
# to cron invocations automatically. Generate with e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=your-long-random-secret

# --- Admin ----------------------------------------------------------------
# Email allowed admin actions (matches the matches-admin RLS policy).
ADMIN_EMAIL=admin@example.com
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com

# ==========================================================================
# Supabase Edge Functions (Deno) read their own env, set via the Supabase
# CLI, NOT this file:  supabase secrets set KEY=value
#   PROJECT_URL            = your Supabase project URL
#   SERVICE_ROLE_KEY       = your service role key
#   FOOTBALL_API_KEY       = your API-Football key
#   FOOTBALL_API_BASE_URL  = https://v3.football.api-sports.io
# ==========================================================================
